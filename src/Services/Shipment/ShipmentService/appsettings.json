{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "ShipmentDb": "Server=localhost;Database=package-delivery-shipment;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Services": {
    "PackageGrpcUrl": "http://localhost:5006",
    "DriverBaseUrl": "http://localhost:5005"
  },
  "Internal": {
    "ApiKey": "SET_VIA_ENVIRONMENT_VARIABLE"
  },
  "Sla": {
    "CheckIntervalMinutes": 15,
    "ThresholdHours": {
      "SameDay": 8,
      "Express": 48,
      "Standard": 120
    }
  },
  "RabbitMq": {
    "Host": "localhost",
    "Username": "guest",
    "Password": "SET_VIA_ENVIRONMENT_VARIABLE",
    "Queues": {
      "ShipmentCreated": "shipment.created",
      "ShipmentStatusChanged": "shipment.status-changed",
      "ShipmentSlaBreached": "shipment.sla-breached"
    }
  },
  "Jwt": {
    "Key": "SET_VIA_ENVIRONMENT_VARIABLE_DO_NOT_USE_IN_PROD",
    "Issuer": "IdentityService",
    "Audience": "PackageDeliverySystem"
  },
  "Stripe": {
    "SecretKey": "",
    "WebhookSecret": "",
    "PublishableKey": ""
  },
  "FileStorage": {
    "RootPath": "App_Data/uploads",
    "PublicBaseUrl": "/uploads"
  },
  "AllowedHosts": "*"
}
